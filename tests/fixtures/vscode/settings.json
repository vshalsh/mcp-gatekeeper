// VS Code user settings (JSONC: comments and trailing commas are allowed)
{
  "editor.fontSize": 14,
  "files.autoSave": "afterDelay",
  /* MCP servers available to agent mode */
  "mcp": {
    "inputs": [
      {"type": "promptString", "id": "gh-token", "description": "GitHub token", "password": true},
    ],
    "servers": {
      "github": {
        "type": "stdio",
        "command": "docker",
        "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:gh-token}"
        }
      },
      "my-internal-api": {
        "type": "sse",
        "url": "http://10.20.0.15:9000/sse", // TODO move behind TLS
      },
      "home-fs": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "~"],
      },
    },
  },
}
