{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "/Users/alex/projects/website"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch==2025.4.7"]
    },
    "docs": {
      "type": "http",
      "url": "https://mcp.docs-vendor.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${DOCS_API_TOKEN}"
      }
    },
    "sqlite": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "-v", "/Users/alex/data:/data", "mcp/sqlite:1.2.0", "--db-path", "/data/app.db"]
    }
  }
}
